NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Square Payments
NEXT_PUBLIC_SQUARE_APP_ID=sandbox-sq0idb-xxx
NEXT_PUBLIC_SQUARE_LOCATION_ID=xxx
SQUARE_ACCESS_TOKEN=xxx
SQUARE_WEBHOOK_SIGNATURE_KEY=xxx
SQUARE_ENVIRONMENT=sandbox

# Invoice / Company Info
INVOICE_COMPANY_NAME=Your Agency s.r.o.
INVOICE_COMPANY_ADDRESS=Bratislava, Slovakia
INVOICE_COMPANY_ICO=12345678
INVOICE_COMPANY_DIC=SK12345678
INVOICE_COMPANY_IBAN=SK00 0000 0000 0000 0000 0000

# GitHub Deployment (auto-deploy pipeline)
GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=your-github-org

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=xxx
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_ZONE_ID=xxx          # Zone ID for your domain (needed for DNS record creation)

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.sk
SMTP_PASS=your-email-password
SMTP_FROM="Shark Media <info@yourdomain.sk>"

# Stripe — credit top-up Checkout
# See docs/STRIPE_SETUP.md for the full account + webhook setup guide.
# Without these, the "Platba kartou" button in the top-up dialog shows
# "platba kartou momentálne nie je dostupná" — BySquare QR still works.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI Content Generation
# All four are optional , the composer falls back to whichever
# provider is selected in /tech/settings/ai. Set the key for the one
# you've chosen there. OpenAI is the recommended production default.
#
# OpenAI (gpt-4o-mini, ~$0.003 per whole-site generation):
#   1. Get key:    https://platform.openai.com/api-keys
#   2. Load credit (min $5): https://platform.openai.com/settings/organization/billing
#   3. Set spending cap:    https://platform.openai.com/settings/organization/limits
OPENAI_API_KEY=

# Groq (free tier, Llama 3.3 70B , works as zero-cost fallback):
#   https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (free tier, region-restricted , may not work in EU without billing):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
